# ==============================================================================
# BrandGuard Preflight - Environment Configuration
# ==============================================================================

# --- Application Ports ---
WEB_PORT=3000
API_PORT=4000
ML_PORT=8000
MONGO_PORT=27017
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Node Environment ---
NODE_ENV=development

# --- MongoDB Configuration ---
MONGODB_URI=mongodb://mongo:27017/brandguard
MONGO_INITDB_DATABASE=brandguard

# --- MinIO (S3-Compatible Object Storage) Configuration ---
MINIO_ENDPOINT=minio
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=brandguard

# --- Backend JWT Configuration ---
JWT_SECRET=brandguard-super-secret-jwt-key-2026-development-only
JWT_EXPIRES_IN=24h

# --- ML Service Configuration ---
ML_SERVICE_URL=http://ml:8000

# --- Frontend Configuration ---
VITE_API_URL=http://localhost:4000
