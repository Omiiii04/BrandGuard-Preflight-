# ==============================================================================
# BrandGuard Preflight — Environment Configuration
# Copy this file to .env and fill in your values.
# ⚠️  Never commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# GENERAL
# ------------------------------------------------------------------------------
# Runtime environment: development | production | test
NODE_ENV=development

# ------------------------------------------------------------------------------
# SERVICE PORTS (host-side port bindings for Docker Compose)
# ------------------------------------------------------------------------------
WEB_PORT=3000          # React frontend (Nginx)
API_PORT=4000          # Node.js Express backend
ML_PORT=8000           # Python FastAPI ML service
MONGO_PORT=27017       # MongoDB
MINIO_PORT=9000        # MinIO S3-compatible API
MINIO_CONSOLE_PORT=9001  # MinIO web console

# ------------------------------------------------------------------------------
# MONGODB
# ------------------------------------------------------------------------------
# Production: use a full connection string with credentials, e.g.
#   mongodb+srv://<user>:<pass>@cluster.mongodb.net/brandguard?retryWrites=true
MONGODB_URI=mongodb://mongo:27017/brandguard
MONGO_INITDB_DATABASE=brandguard

# Optional: enable authentication for standalone MongoDB
# MONGO_INITDB_ROOT_USERNAME=root
# MONGO_INITDB_ROOT_PASSWORD=changeme

# ------------------------------------------------------------------------------
# MINIO (S3-Compatible Object Storage)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=minio              # Hostname inside Docker network; use IP/FQDN externally
MINIO_PORT_INTERNAL=9000          # Port the MinIO server listens on (inside container)
MINIO_USE_SSL=false               # Set to true when terminating TLS at MinIO
MINIO_ROOT_USER=minioadmin        # Admin access key  <- change in production
MINIO_ROOT_PASSWORD=minioadmin    # Admin secret key  <- change in production
MINIO_BUCKET=brandguard           # Default bucket name (created on first run)

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION (Backend)
# ------------------------------------------------------------------------------
# Use a long random string in production: openssl rand -hex 64
JWT_SECRET=brandguard-super-secret-jwt-key-change-me-in-production
JWT_EXPIRES_IN=24h                # Access-token lifetime (e.g. 1h, 24h, 7d)

# ------------------------------------------------------------------------------
# ML SERVICE (Backend to ML internal call)
# ------------------------------------------------------------------------------
ML_SERVICE_URL=http://ml:8000     # Internal Docker DNS; never exposed to the browser

# Confidence thresholds (optional overrides for judge.py)
# ML_CONFIDENCE_HIGH=0.85
# ML_CONFIDENCE_LOW=0.60

# External LLM - only used when org.settings.allowExternalModel = true
# and after redactionGateway.js has scrubbed watchlist terms.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# FRONTEND (Vite build-time variables - must be prefixed VITE_)
# ------------------------------------------------------------------------------
# URL the browser uses to reach the backend API
VITE_API_BASE_URL=http://localhost:4000

# Set to "true" to show the AI-use disclosure banner unconditionally in dev
# VITE_SHOW_AI_NOTICE=true

# ------------------------------------------------------------------------------
# SECURITY / UPLOAD LIMITS (Backend)
# ------------------------------------------------------------------------------
# Maximum file upload size in bytes (default 10 MB)
# UPLOAD_MAX_BYTES=10485760

# Comma-separated MIME types allowed for source uploads
# UPLOAD_ALLOWED_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/markdown

# CORS - comma-separated list of allowed origins (leave blank to allow all in dev)
# CORS_ALLOWED_ORIGINS=https://app.brandguard.example.com

# ------------------------------------------------------------------------------
# SHELF-LIFE SCHEDULER (Backend cron)
# ------------------------------------------------------------------------------
# Cron expression for fact / source expiry warning job (default: midnight daily)
# SHELF_LIFE_CRON=0 0 * * *

# Days before expiry to send warning notification
# SHELF_LIFE_WARN_DAYS=30

# ------------------------------------------------------------------------------
# RATE LIMITING (Backend)
# ------------------------------------------------------------------------------
# Maximum requests per window per IP
# RATE_LIMIT_MAX=100
# Rate limit window in milliseconds (default 15 minutes)
# RATE_LIMIT_WINDOW_MS=900000

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
# Log level: error | warn | info | http | debug
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# AGENT GATE (Phase 2 - external AI tool integration)
# ------------------------------------------------------------------------------
# Shared API key for POST /v1/gate/check (generated per client)
# GATE_API_KEY=gate-key-replace-me
DEMO_MODE=true
